@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/SimplyCppFunctions.cmake")

find_or_install_package(sc-core simply-cpp-dev simply-cpp 1.16.0)
# pdflite.h's built-in fonts come from sc-graphics' sc::standard_font.
find_or_install_package(sc-graphics simply-cpp-graphics-dev simply-cpp-graphics 6.2.0)
# The static library links zlib.
include(CMakeFindDependencyMacro)
find_dependency(ZLIB)

include("${CMAKE_CURRENT_LIST_DIR}/sc-pdfliteTargets.cmake")
